# ── 密钥与本地配置：绝不能入库 ──────────────────────────────────────────
.env
.env.*
!.env.example
*.token
secrets/

# ── 运行时数据：价格明细会很大，且可重新采集 ────────────────────────────
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
logs/
*.log

# ── 探测落盘的原始响应：体积大，且可能包含站点私有内容 ──────────────────
# 保留 .meta.json（小、有判读价值），丢弃 .raw 原始体
data/fixtures/*.raw

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*

# ── 沙箱权限修复留下的恢复脚本（本机专属，与项目无关）──────────────────
../dsh-acl-recovery/
